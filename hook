#!/bin/sh
# Braincell's Claude Code hook: hook <what happened>, with the event JSON on stdin.
# Keeps one small log per session that is mid-turn, for the app to read. It stores tool names,
# Claude's one-line command descriptions, its to-do list and the names of the models you've used:
# never prompts, code or commands. It prints nothing and never touches the network.
umask 077
home="${BRAINCELL_HOME:-$HOME/.braincell}"
dir="$home/busy"
event=$( { head -c 4096; cat >/dev/null; } | tr '\n\r' '  ')
case "$event" in *\"session_id\"*) ;; *) exit 0 ;; esac
id=${event#*\"session_id\"}; id=${id#*\"}; id=${id%%\"*}
case "$id" in ""|*[!A-Za-z0-9_-]*) exit 0 ;; esac
log="$dir/$id"
ping() { : > "$dir/.ping.$$" && rm -f "$dir/.ping.$$"; }   # a folder event, so the app looks

case "$1" in
  busy) mkdir -p "$dir" && rm -f "$log" && echo prompt > "$log" ;;      # a turn started
  tool) mkdir -p "$dir"; [ -e "$log" ] || echo prompt > "$log"          # a tool is about to run
        rm -f "$home/spent"
        name=${event#*\"tool_name\"}; name=${name#*\"}; name=${name%%\"*}
        case "$name" in
          TodoWrite|TaskCreate|TaskUpdate|*update_plan) printf 'tool %s\n' "$event" ;;
          Bash|Agent|Task) what=
            case "$event" in *\"description\"*) what=${event#*\"description\"}; what=${what#*\"}; what=${what%%\"*}; what=${what%\\} ;; esac
            printf 'tool {"tool_name":"%s","tool_input":{"description":"%s"}}\n' "$name" "$what" ;;
          *) printf 'tool {"tool_name":"%s"}\n' "$name" ;;
        esac >> "$log"; ping ;;
  wait) [ -e "$log" ] && echo wait >> "$log" && ping ;;                 # Claude is asking for permission
  tidy) [ -e "$log" ] && echo tidy >> "$log" && ping ;;                 # Claude is compacting its context
  beat) if [ "$(tail -c 5 "$log" 2>/dev/null)" = wait ]; then echo done >> "$log"; ping
        else touch -c "$log" 2>/dev/null; fi ;;                         # a tool finished: still going
  idle) rm -f "$log" "$home/spent" ;;                                   # the turn ended
  quit) rm -f "$log" ;;                                                 # the session ended, or sat idle
  fail) case "$event" in *\"rate_limit\"*) : > "$home/spent" ;; esac    # the turn died: out of usage?
        rm -f "$log" ;;
  model) case "$event" in *\"model\"*) ;; *) exit 0 ;; esac             # a session started: is its model new here?
        model=${event#*\"model\"}; model=${model#*\"}; model=${model%%\"*}; model=${model%%\[*}
        case "$model" in ""|*[!A-Za-z0-9._-]*) exit 0 ;; esac
        grep -qxF "$model" "$home/models" 2>/dev/null || { echo "$model" >> "$home/models"; : > "$home/fresh"; } ;;
esac
exit 0
